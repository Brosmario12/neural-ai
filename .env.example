# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Optional legacy key if you still use the previous AI routes
ANTHROPIC_API_KEY=sk-ant-v0-...

# Wompi Online Payments
WOMPI_PUBLIC_KEY=pub_prod_xxxx
WOMPI_PRIVATE_KEY=prv_prod_xxxx
WOMPI_INTEGRITY_SECRET=prod_integrity_xxxx
WOMPI_EVENTS_SECRET=prod_events_xxxx

# Wompi Payouts
WOMPI_PAYOUTS_API_KEY=api_key_xxxx
WOMPI_PAYOUTS_USER_PRINCIPAL_ID=user_principal_id_xxxx
WOMPI_PAYOUTS_EVENTS_SECRET=prod_events_xxxx
WOMPI_PAYOUTS_SOURCE_ACCOUNT_ID=optional_account_id
